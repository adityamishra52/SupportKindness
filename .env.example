# Frontend public environment variables for Vite.
# Copy this file to .env for local development.
# In Vercel, add these values in Project Settings > Environment Variables.
# Do not put backend secrets, private API keys, JWT secrets, or passwords here.

# API and app metadata
# Local development:
# VITE_API_BASE_URL=http://localhost:5000/api
#
# Vercel production with Render backend:
VITE_API_BASE_URL=https://carecontributionbackend.onrender.com/api
# Optional. Only set if public asset URLs should use a different host than VITE_API_BASE_URL.
VITE_BACKEND_BASE_URL=https://carecontributionbackend.onrender.com
VITE_APP_NAME=Support Kindness
VITE_APP_TAGLINE=Community Support
VITE_SITE_DESCRIPTION=A community support initiative focused on animal help, food distribution, tree plantation, and transparent local impact.
VITE_UPI_ID=
VITE_WEBSITE_URL=https://yourdomain.com
# Must exactly match Render backend ADMIN_PASSWORD, otherwise admin uploads/deletes return 401.
VITE_ADMIN_PASSWORD=Akm@9591
# Optional: if set, must match backend ADMIN_TOKEN. Password auth is also supported.
VITE_ADMIN_TOKEN=

# Contact details
VITE_SUPPORT_EMAIL=support@example.com
VITE_CONTACT_EMAIL=contact@example.com
VITE_CONTACT_FORM_RECEIVER_EMAIL=contact@example.com
VITE_PHONE_NUMBER=+91XXXXXXXXXX
VITE_ADDRESS=Your Address Here
VITE_GOOGLE_MAP_URL=

# Social links
VITE_WHATSAPP_NUMBER=91XXXXXXXXXX
VITE_WHATSAPP_URL=https://wa.me/91XXXXXXXXXX
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_X_URL=
VITE_LINKEDIN_URL=
VITE_YOUTUBE_URL=
